# Copy this file to .env and fill in the values. NEVER commit the real .env.

# PostgreSQL connection string used by the app (Prisma).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Shadow database used by `prisma migrate dev` (development only).
SHADOW_DATABASE_URL=

# Google Gemini API key.
GEMINI_API_KEY=
